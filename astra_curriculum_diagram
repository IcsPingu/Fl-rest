// ASTRA Curriculum Logic
digraph astra_curriculum {
	fontname=Helvetica fontsize=10 rankdir=TB splines=ortho
	node [color="#000000" fillcolor="#FFFFFF" fontname=Helvetica fontsize=10 shape=box style="rounded,filled"]
	edge [arrowhead=vee color="#000000" fontname=Helvetica fontsize=9]
	Input [label="Input Batch
(x, y)" fillcolor="#E0E0E0" shape=parallelogram]
	GlobalModel [label="Global Model
(w_t)" fillcolor="#E0E0E0" shape=cylinder]
	Curriculum [label="Curriculum Gate
(Is Teacher Active?)" fillcolor="#F0F0F0" shape=diamond]
	Teacher [label="Frozen Teacher
(w_teach)" fillcolor="#F8F8F8" style="dashed,filled"]
	KD_Loss [label="Distillation Loss
(L_KD)" shape=ellipse]
	Student [label="Active Student
(w_k)"]
	CE_Loss [label="CE Loss
(L_CE)" shape=ellipse]
	Prox_Loss [label="Proximal Loss
(L_Prox)" shape=ellipse]
	TotalLoss [label="Total Loss
(L_ASTRA)" fillcolor="#D0D0D0" shape=box style=filled]
	Update [label="Weight Update
(w_k ← w_k - η∇L)" fillcolor="#D0D0D0" shape=box style=filled]
	Input -> Student [label=x]
	GlobalModel -> Curriculum [label="Round t"]
	GlobalModel -> Student [label="Initialize w_k" style=dashed]
	Student -> CE_Loss [label="Logits (z_s)"]
	Input -> CE_Loss [label="Labels (y)"]
	GlobalModel -> Prox_Loss [label="Reference (w_t)"]
	Student -> Prox_Loss [label="Weights (w_k)"]
	Curriculum -> Teacher [label="Yes (Bootcamp/Correction)" style=bold]
	GlobalModel -> Teacher [label="Initialize w_teach" style=dashed]
	Input -> Teacher [label=x]
	Teacher -> KD_Loss [label="Logits (z_t)"]
	Student -> KD_Loss [label="Logits (z_s)"]
	CE_Loss -> TotalLoss
	Prox_Loss -> TotalLoss
	KD_Loss -> TotalLoss [label="α_t * KL"]
	TotalLoss -> Update
	subgraph cluster_legend {
		fontsize=9 label=Legend style=rounded
		L_Active [label="Active Path" height=0 shape=none width=0]
		L_Conditional [label="Conditional Path" height=0 shape=none width=0]
		L_Active -> L_Conditional [label="Standard Flow" style=solid]
		L_Active -> L_Conditional [label="Switchable Flow" style=bold]
	}
}
